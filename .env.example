# Copy to .env and replace every CHANGE_ME value. Never commit .env.
# Placeholders only; no real credentials belong in this file.

# Shared
APP_ENV=development
LOG_LEVEL=INFO

# Data collector (public, unauthenticated endpoints; no exchange keys are needed or wanted)
COLLECTOR_INTERVAL=1.0
COLLECTOR_SYMBOLS=BTC/USDT

# API
API_HOST=0.0.0.0
API_PORT=8000

# Storage profile (docker compose --profile storage up -d)
POSTGRES_USER=arbitrage
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=arbitrage
INFLUXDB_USER=arbitrage
INFLUXDB_PASSWORD=CHANGE_ME_MIN_8_CHARS
INFLUXDB_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN
INFLUXDB_ORG=arbitrage
INFLUXDB_BUCKET=market_data
REDIS_PASSWORD=CHANGE_ME
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# Local (non-Docker) overrides used by the API and dashboard
# ARBITRAGE_DATA_ROOT=data/raw
# ARBITRAGE_DATA_SOURCE=live
# ARBITRAGE_MODELS_DIR=models
# ARBITRAGE_BACKTEST_DIR=experiments/results/api_backtests
